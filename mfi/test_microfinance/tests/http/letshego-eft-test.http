###
# Test 1: Get Institution List
# This should return all supported banks/institutions
###
GET {{baseUrl}}/{{consumerId}}/outwards/institution
apikey: {{apikey}}

###
# Test 2: Account Enquiry - Valid Account
# This should return account details for a valid account
###
GET {{baseUrl}}/{{consumerId}}/outwards/accountenquiry/0752518001
fsp-destination: 016
x-user-platform: web
apikey: {{apikey}}

###
# Test 3: Account Enquiry - Different Bank
# Test with different bank code
###
GET {{baseUrl}}/{{consumerId}}/outwards/accountenquiry/3401000000065
fsp-destination: 035
x-user-platform: web
apikey: {{apikey}}

###
# Test 4: Account Enquiry - Invalid Account
# This should return an error for invalid account
###
GET {{baseUrl}}/{{consumerId}}/outwards/accountenquiry/1234567890
fsp-destination: 999
x-user-platform: web
apikey: {{apikey}}

###
# Test 5: Initiate Transfer - Small Amount (TIPS)
# This should initiate a transfer via TIPS (amount < 20M TZS)
###
POST {{baseUrl}}/{{consumerId}}/outwards/transfers
Content-Type: application/json
x-user-platform: web
apikey: {{apikey}}

{
    "payee": {
        "identifierType": "BANK",
        "identifier": "0752518001",
        "fspId": "016",
        "fullName": "HAJI NYEMBO",
        "accountCategory": "PERSON",
        "accountType": "BANK",
        "identity": {
            "type": "NIN",
            "value": ""
        },
        "additionalInfo": null
    },
    "payer": {
        "identifierType": "BANK", 
        "identifier": "21710176786",
        "fspId": "044",
        "fullName": "LETSHEGO TEST ACCOUNT",
        "accountCategory": "BUSINESS",
        "accountType": "BANK",
        "identity": {
            "type": "NIN",
            "value": ""
        }
    },
    "amount": {
        "amount": "50000.0",
        "currency": "TZS"
    },
    "endUserFee": {
        "amount": "130",
        "currency": "TZS"
    },
    "transactionType": {
        "scenario": "TRANSFER",
        "initiator": "PAYER",
        "initiatorType": "CONSUMER",
        "subScenario": null
    },
    "description": "Test transfer via HTTP client",
    "payerRef": "044-HTTP{{$timestamp}}",
    "callbackUrl": "http://localhost:8005/api/letshego-callback"
}

###
# Test 6: Initiate Transfer - Large Amount (would use TISS if supported)

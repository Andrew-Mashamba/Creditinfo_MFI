    "callbackUrl": "http://localhost:8005/api/letshego-callback"
}

###
# Test 7: Transaction Status - Valid Reference
# Check status of a known transaction
###
GET {{baseUrl}}/{{consumerId}}/outwards/status/044-WK175371850125227076
apikey: {{apikey}}

###
# Test 8: Transaction Status - Invalid Reference
# This should return error for non-existent transaction
###
GET {{baseUrl}}/{{consumerId}}/outwards/status/INVALID-REF-123
apikey: {{apikey}}

###
# Test 9: Transaction Reversal
# Reverse a transaction (use valid payerRef from previous transfer)
###
POST {{baseUrl}}/{{consumerId}}/outwards/transfers/reversal
Content-Type: application/json
apikey: {{apikey}}

{
    "payerRef": "044-20220616000009",
    "reversalReason": "Test reversal via HTTP client"
}

###
# Test 10: Invalid Transfer - Missing Required Fields
# This should return validation error
###
POST {{baseUrl}}/{{consumerId}}/outwards/transfers
Content-Type: application/json
x-user-platform: web
apikey: {{apikey}}

{
    "payee": {
        "identifier": "0752518001"
    },
    "amount": {
        "amount": "50000.0"
    },
    "description": "Invalid transfer test"
}

###
# Test 11: Invalid API Key
# This should return authentication error
###
GET {{baseUrl}}/{{consumerId}}/outwards/institution
apikey: invalid-api-key-12345


        "accountCategory": "PERSON",
        "accountType": "BANK",
        "identity": {
            "type": "NIN",
            "value": ""
        },
        "additionalInfo": null
    },
    "payer": {
        "identifierType": "BANK",
        "identifier": "21710176786",
        "fspId": "044",
        "fullName": "LETSHEGO TEST ACCOUNT",
        "accountCategory": "BUSINESS",
